# Files excluded from the submission tarball (`whest package` / `whest submit`).
# The grader only runs your `Estimator` (estimator.py) + any modules it imports
# at scoring time. Everything below is local-only tooling/docs and would
# otherwise trip the 50-file submission cap.

# Version control / CI / envs
.git/
.github/
.claude/
.playwright-mcp/
.venv/
.python-version
.aicrowd/
.env
.env.*
*.key
*.pem
*token*
*secret*

# Caches & build artifacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.tmp/

# Local-iteration helpers — used by `python estimator.py`, NOT by the grader
local_engine.py
examples/
tests/

# Docs, assets, and project scaffolding
docs/
writeup/
assets/
scripts/
Makefile
README.md
pyproject.toml
uv.lock

# Notebooks and logs (not needed by grader)
*.ipynb
eval_variants.py
estimator_*_tmp.py
bench_logs/
submission-*.tar.gz

# Local analysis caches & scratch (not needed by grader)
.est*.npz
*_cache.npz
relu_moment_propagation.py
prokpt.txt
submission.tar.gz
.ab_*.py
sobol_points_ext*.npz
